uint8_t VL6180X_WriteReg(uint16_t reg,uint8_t data)
{
	//HAL_I2C_Mem_Write_DMA(&hi2c2,(VL6180X_DEFAULT_I2C_ADDR<<1)|0,reg,I2C_MEMADD_SIZE_16BIT,&data,1);	
	HAL_I2C_Mem_Write_IT(&hi2c2,(VL6180X_DEFAULT_I2C_ADDR<<1)|0,reg,I2C_MEMADD_SIZE_16BIT,&data,1);
	//HAL_I2C_Mem_Write(&hi2c2,(VL6180X_DEFAULT_I2C_ADDR<<1)|0,reg,I2C_MEMADD_SIZE_16BIT,&data,1,0xff);
	return 0;
}
uint8_t VL6180X_ReadReg(uint16_t reg)
{ 
	uint8_t data;
	//HAL_I2C_Mem_Read(&hi2c2,(VL6180X_DEFAULT_I2C_ADDR<<1)|1,reg,I2C_MEMADD_SIZE_16BIT,&data,1,0xff);
	HAL_I2C_Mem_Read_IT(&hi2c2,(VL6180X_DEFAULT_I2C_ADDR<<1)|1,reg,I2C_MEMADD_SIZE_16BIT,&data,1);
	//HAL_I2C_Mem_Read_DMA(&hi2c2,(VL6180X_DEFAULT_I2C_ADDR<<1)|1,reg,I2C_MEMADD_SIZE_16BIT,&data,1);
	return data;
}













